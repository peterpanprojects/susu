# ==============================================================================
# SUSU PLATFORM ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your real database & gateway credentials
# ==============================================================================

# Supabase Database Configuration
# Obtain from your Supabase Project Settings -> API (https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Paystack Gateway Configuration
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks (https://dashboard.paystack.com/#/settings/developer)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_real_paystack_public_key
VITE_PAYSTACK_SECRET_KEY=sk_test_your_real_paystack_secret_key

# Super Admin Initial Identity & Provisioning Credentials
VITE_SUPER_ADMIN_EMAIL=peterpanprojects145@gamil.com
VITE_SUPER_ADMIN_INITIAL_PASSWORD=peter145

# Live Support / Rezolv Configuration (Optional)
VITE_REZOLV_API_KEY=
